{
  "name": "@lpm.dev/neo.sanitize",
  "version": "1.0.0",
  "description": "Modern, zero-dependency HTML sanitization library - XSS prevention for browsers and Node.js",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./validators": {
      "types": "./dist/validators/index.d.ts",
      "import": "./dist/validators/index.js",
      "require": "./dist/validators/index.cjs"
    },
    "./schemas": {
      "types": "./dist/config/schemas.d.ts",
      "import": "./dist/config/schemas.js",
      "require": "./dist/config/schemas.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    ".lpm/skills",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:package": "node scripts/verify-package.mjs",
    "test:performance": "node --expose-gc scripts/verify-performance.mjs",
    "test:corpus": "vitest run test/security test/unit/xss-vectors/parser-contexts.test.ts test/unit/core/insertion-context.test.ts test/runtime-matrix.test.ts",
    "test:fuzz": "vitest run test/fuzz",
    "test:browser": "playwright test",
    "test:watch": "vitest",
    "bench": "vitest bench",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "release:check": "lpm run typecheck && lpm run test:coverage && lpm run build && lpm run test:package",
    "prepublishOnly": "lpm run release:check"
  },
  "keywords": [
    "lpm",
    "sanitize",
    "html",
    "xss",
    "security",
    "dom",
    "dompurify",
    "sanitize-html",
    "browser",
    "nodejs",
    "zero-dependency",
    "typescript"
  ],
  "author": "neo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ne-ooo/neo.sanitize"
  },
  "bugs": {
    "url": "https://github.com/ne-ooo/neo.sanitize/issues"
  },
  "homepage": "https://github.com/ne-ooo/neo.sanitize#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "lpm": {
    "overrides": {
      "esbuild": "^0.28.1"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^3.2.6",
    "dompurify": "^3.4.14",
    "fast-check": "4.9.0",
    "happy-dom": "20.11.10",
    "jsdom": "^24.0.0",
    "sanitize-html": "^2.12.1",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  }
}
